##---------------------------------------------------
## Remove autosaves generated by the Matlab editor
## We have git for backups!
##---------------------------------------------------

# Autosave extensions and auxiliary files
*.asv
*.autosave
*.m~
*.slxc

# Workspace files
*.mat

# Folders
tmp/

# Simulink and Coder folders
matlab_root_*/
slprj/

# ignore ROSBAG files
*.bag